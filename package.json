{
  "name": "sanctum-media-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人书影音、游戏与文化体验记录及静态网站",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
